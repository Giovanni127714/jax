{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,examples/**,configs/**,.venv/**,wandb/**,.pytest_cache/**,.github/**,*.md,*.png,regression_checkpoint/**,.scratch_screens/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
