# Copy this file to .env (in the project root) and fill in your key.
# .env is gitignored - never commit your real key.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: only needed if your MySQL setup differs from Laragon's default
# (root user, no password, localhost:3306).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=jax_chat
